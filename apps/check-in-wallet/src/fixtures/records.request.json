        "kind": "selection.fhir",
        "profiles": [
          "http://hl7.org/fhir/us/insurance-card/StructureDefinition/C4DIC-Coverage",
          "http://hl7.org/fhir/us/core/StructureDefinition/us-core-coverage"
        ]
