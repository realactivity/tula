{
  "name": "tula-check-in-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Tula web wallet for the SMART Health Check-in 1.0 draft. Synthetic patient only.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
