  },
  "dependencies": {
    "@smart-health-checkin/client": "https://github.com/smart-health-checkin/client/releases/download/v0.4.4/smart-health-checkin-client-0.4.4.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "5.6.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
